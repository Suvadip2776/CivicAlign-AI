# Copy to .env at the package root. Never commit real keys.
OPENROUTER_API_KEY=            # base Qwen 3.8 27B, frontier models, GPT-4o/4.1 graders
HF_TOKEN=                      # gated datasets (XSTest) and the OCT model endpoint
NYCCNT_BASE_URL=               # vLLM endpoint serving the OCT model, e.g. https://<host>/v1
NYCCNT_API_KEY=                # bearer token for that endpoint (defaults to HF_TOKEN)
SOCRATA_APP_TOKEN=             # optional: higher NYC Open Data rate limits for the Legistar tools
